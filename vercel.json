{
  "version": 2,
  "functions": {
    "api/proxy.js": {
      "runtime": "@vercel/node"
    },
    "api/download.js": {
      "runtime": "@vercel/node"
    }
  },

  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Accept, Authorization"
        }
      ]
    }
  ]
}
